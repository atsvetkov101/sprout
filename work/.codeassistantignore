# =====================================================================
#  .codeassistantignore — пример для монorepo «Sprout»
#  (DDD-проект: Tickets, Users, Equipment, Coords, Notification и т.д.)
#
#  Этот файл работает как .gitignore, но для ИИ-ассистента:
#  всё перечисленное он не будет читать и добавлять в контекст.
#
#  Переименуйте его в .codeassistantignore в корне проекта
#  и дополните под свой стек.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Зависимости и менеджер пакетов
# ---------------------------------------------------------------------
**/node_modules/
.pnp
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ---------------------------------------------------------------------
# 2. Артефакты сборки и покрытие тестов
# ---------------------------------------------------------------------
**/dist/
**/build/
**/out/
**/coverage/
**/.nyc_output/
*.tgz

# ---------------------------------------------------------------------
# 3. Env-файлы (секреты) — но оставляем пример
# ---------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test
*.env.*
!.env.example

# ---------------------------------------------------------------------
# 4. Логи и временные файлы
# ---------------------------------------------------------------------
**/*.log
logs/
log/
*.debug.log
*.error.log

# ---------------------------------------------------------------------
# 5. Служебные файлы IDE и ОС
# ---------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# ---------------------------------------------------------------------
# 6. Docker и volume-данные (не коммитим)
# ---------------------------------------------------------------------
.dockerenv
docker-compose.override.yml
docker-compose.local.yml
.dockerignore
/data/
/db1_data/
/redis1_data/
/rabbitmq1_data/
/var/lib/postgresql/data/

# ---------------------------------------------------------------------
# 7. Рутовые метаданные пакетов
# ---------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity

# ---------------------------------------------------------------------
# 8. Что ассистент ОБЯЗАН видеть (не прячем):
#    - Tickets/src/**  (доменная модель, vo/, entities/, domain-events/)
#    - package.json, tsconfig.json, jest.config.js
#    - plans/, work/, Doc/  (документация и планы)
# ---------------------------------------------------------------------